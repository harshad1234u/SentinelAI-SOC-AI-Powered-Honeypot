# =============================================================================
# Honeypot SOC Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables are required unless marked (optional).

# Database
DATABASE_URL=postgresql+asyncpg://soc:change-me-in-production@postgres:5432/honeypot_soc

# Redis
REDIS_URL=redis://redis:6379/0

# Loki (Remote VM - designed for future migration to Tailscale/WireGuard/VPN)
LOKI_URL=http://<VM_PUBLIC_IP>:3100

# NVIDIA NIM
NIM_API_KEY=nvapi-xxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
REALTIME_MODEL=nvapi-xxx
FALLBACK_REALTIME_MODEL=nvapi-xxx
INVESTIGATION_MODEL=nvapi-xxx
EMBED_MODEL=nvapi-xxx

# AI Cost Protection
MAX_INVESTIGATION_ATTACKS=50
MAX_RAG_CONTEXT_ATTACKS=20
AI_CACHE_TTL=3600

# Qdrant (Remote VM - designed for future migration to Tailscale/WireGuard/VPN)
QDRANT_URL=http://<VM_PUBLIC_IP>:6333
QDRANT_COLLECTION=attack_vectors

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin User (v1 — single admin, no DB-backed users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# GeoIP
GEOIP_CITY_DB=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb

# Threat Intelligence
ABUSEIPDB_API_KEY=your-abuseipdb-api-key
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
THREAT_INTEL_CACHE_TTL=86400

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Retention
RETENTION_DAYS=30

# Environment
ENVIRONMENT=development
DEBUG=true
